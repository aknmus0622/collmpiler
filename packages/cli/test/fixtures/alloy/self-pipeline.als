pred same_pipeline { c_pipeline.f_pipeline_status' = c_pipeline.f_pipeline_status }
pred ev_pipeline_Start_otherwise[p_attemptsPerPhase: s_num0, p_rounds: s_num2] {
  (some Bool)
  c_pipeline.f_pipeline_status' = ((not (Env.env_output_HasProductionCode = True)) => str_0 else (((Env.env_output_HasProductionCode = True) and (Env.env_output_BoundaryChanged = True)) => str_0 else ((((Env.env_output_HasProductionCode = True) and (not (Env.env_output_BoundaryChanged = True))) and (not (Env.env_output_HasAdapter = True))) => str_6 else str_3)))
}
pred cmd_pipeline_Start[p_attemptsPerPhase: s_num0, p_rounds: s_num2] {
  ((((((c_pipeline.f_pipeline_status) = str_4) and (p_attemptsPerPhase in s_num0_2.*next_num0)) and (s_num0_4 in p_attemptsPerPhase.*next_num0)) and (p_rounds in s_num2_2.*next_num2)) and (s_num2_4 in p_rounds.*next_num2)) and (ev_pipeline_Start_otherwise[p_attemptsPerPhase, p_rounds])
}
