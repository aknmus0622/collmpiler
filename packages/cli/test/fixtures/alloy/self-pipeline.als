  (p_passed = True)
  c_pipeline.f_pipeline_status' = str_6
}
pred cmd_pipeline_DesignChecked[p_passed: Bool] {
  ((c_pipeline.f_pipeline_status) = str_0) and (ev_pipeline_DesignChecked_case1[p_passed])
}
pred cmd_pipeline_WiringChecked[p_passed: Bool] {
  ((c_pipeline.f_pipeline_status) = str_6) and (no Bool)
}
pred ev_pipeline_CurrentCodeGraded_case1[p_passed: Bool] {
  (p_passed = True)
  c_pipeline.f_pipeline_status' = str_1
}
pred ev_pipeline_CurrentCodeGraded_otherwise[p_passed: Bool] {
  (not (p_passed = True))
  c_pipeline.f_pipeline_status' = str_5
}
pred cmd_pipeline_CurrentCodeGraded[p_passed: Bool] {
  ((c_pipeline.f_pipeline_status) = str_3) and (ev_pipeline_CurrentCodeGraded_case1[p_passed] or ev_pipeline_CurrentCodeGraded_otherwise[p_passed])
}
pred ev_pipeline_ImplementationChecked_case1[p_passed: Bool] {
