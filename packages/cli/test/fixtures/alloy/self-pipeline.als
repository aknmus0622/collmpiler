  c_pipeline.f_pipeline_status' = str_1
}
pred cmd_pipeline_ImplementationChecked[p_passed: Bool] {
  ((c_pipeline.f_pipeline_status) = str_5) and (ev_pipeline_ImplementationChecked_case1[p_passed])
