{
  "behaviors": [
    {
      "description": "One value of a specification is written into the IR, and the answer is what is written.",
      "from": [
        "READY"
      ],
      "name": "Write",
      "onlyIf": [],
      "when": {
        "The value is a constant (whatever it is, null included)": {
          "responds": {
            "constant": {
              "$ref": "input:value.constant"
            }
          }
        },
        "The value is a reference by name, or a reference to a column of a decision table": {
          "responds": {
            "reference": {
              "$ref": "calculation:referenceText"
            }
          }
        },
        "otherwise": {
          "responds": {
            "was": {
              "$ref": "input:value.was"
            }
          }
        }
      }
    }
  ],
  "decisions": {
    "form": {
      "rows": {
        "The reference is to a calculation": {
          "prefix": "calculation:"
        },
        "The reference is to a query answer": {
          "prefix": "query:"
        },
        "The reference is to an input of the command": {
          "prefix": "input:"
        },
        "The reference is to remembered data": {
          "prefix": "data:"
        },
        "otherwise": {
          "prefix": "decision:"
        }
      }
    }
  },
  "descriptions": {
    "component": "Writes the values of a specification into its intermediate representation, one value at a time. A constant is written as it is. A reference is written as one text. A reference to the state before a command is written as the states it lists."
  },
  "irVersion": 7,
  "model": {
    "calculations": {
      "referenceText": {
        "description": "The prefix the reference form gives, followed by what is referred to: for a reference by name, the name; for a column of a decision table, the table, a dot, and the column. Nothing else is added and nothing is trimmed.",
        "output": "string"
      }
    },
    "commands": {
      "Write": {
        "value": {
          "oneOf": {
            "column": {
              "record": {
                "column": "string",
                "table": "string"
              }
            },
            "constant": "value",
            "reference": {
              "record": {
                "name": "string",
                "target": [
                  "input",
                  "data",
                  "query",
                  "calculation"
                ]
              }
            },
            "was": {
              "list": "string"
            }
          }
        }
      }
    },
    "data": {},
    "effects": {},
    "init": "READY",
    "outputs": {
      "Write": {
        "oneOf": {
          "constant": "value",
          "reference": "string",
          "was": {
            "list": "string"
          }
        }
      }
    },
    "queries": {},
    "states": [
      "READY"
    ]
  }
}
