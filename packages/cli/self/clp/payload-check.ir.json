          },
          "query": "fieldDeclared"
        }
      },
      "description": "A field the specification gives; what is known about its value follows. In a slot that is not checked, nothing happens. A field the slot does not declare is reported: in an answer of variants as wrong-shape (for the slot), otherwise as unknown-field (for that field); what follows about its value is ignored. A declared field is checked next.",
      "from": [
        "INACTIVE",
        "ACTIVE",
        "CHECKING",
        "SETTLED"
      ],
      "name": "GivenField",
      "onlyIf": [],
      "when": {
        "The slot's fields are checked, it is an answer of variants, and it does not declare the given field": {
          "emits": [
            {
              "effect": "Report",
              "input": {
                "code": "wrong-shape",
                "field": ""
              }
            }
          ],
          "goTo": "SETTLED",
          "set": {
            "checkedField": {
              "$ref": "input:name"
            }
          }
        },
        "The slot's fields are checked, it is not an answer of variants, and it does not declare the given field": {
          "emits": [
            {
              "effect": "Report",
              "input": {
                "code": "unknown-field",
                "field": {
                  "$ref": "input:name"
                }
              }
            }
          ],
          "goTo": "SETTLED",
          "set": {
            "checkedField": {
              "$ref": "input:name"
            }
          }
        },
        "The slot's fields are not checked": {},
        "otherwise": {
          "goTo": "CHECKING",
          "set": {
            "checkedField": {
              "$ref": "input:name"
            }
          }
        }
      }
    },
    {
      "description": "Whether a value of a structured type fits, as the framework compared it. If not, mismatch, and what follows is ignored.",
      "from": [
        "ACTIVE",
        "CHECKING",
        "SETTLED",
        "INACTIVE"
      ],
      "name": "Judged",
      "onlyIf": [],
      "when": {
        "A given field is being checked, and the framework judged that the value does not fit it": {
