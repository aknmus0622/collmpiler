  "decisions": {
    "constantFit": {
      "rows": {
        "The field takes a boolean and the value is a boolean": {
          "fits": true
        },
        "The field takes a number, and the value is an integer or a number within the field's bounds": {
          "fits": true
        },
        "The field takes a string and the value is a string": {
          "fits": true
        },
        "The field takes an integer, and the value is an integer within the field's bounds": {
          "fits": true
        },
        "The field takes one of a fixed set of strings, and the value is a string in that set": {
          "fits": true
        },
        "otherwise": {
          "fits": false
        }
      }
    },
    "typeFit": {
      "rows": {
        "The value's type is integer and the field takes a number": {
          "fits": true
        },
        "The value's type is the same as what the field takes": {
          "fits": true
        },
        "otherwise": {
          "fits": false
        }
      }
    }
  },
  "descriptions": {
    "component": "Checks, slot by slot, what a specification gives wherever a value is placed, and reports every mismatch with what is declared: an unknown target, a shape that does not fit, a declared field that is not given, a given field that is not declared, and a value that does not fit its field. For one given field at most one is reported: the first.",
    "data.checkedField": "The given field being walked.",
    "data.slotKind": "The kind of slot being walked.",
    "data.variants": "Whether the slot is a command's answer of the form 'one of several variants'.",
    "effects.Report": "Something is wrong in the slot being walked, about this field (the empty name for the slot as a whole).",
    "queries.fieldDeclared": "Whether the slot declares a field of this name.",
    "queries.fieldGiven": "Whether the specification gives a value for that field.",
    "queries.fieldKind": "What that field takes: a primitive, one of a fixed set of strings (enum), any value, or a structured type.",
    "queries.fieldOptional": "Whether that field may be absent (null).",
    "queries.hasMaximum": "Whether that field has a maximum.",
    "queries.hasMinimum": "Whether that field has a minimum.",
    "queries.maximum": "That field's maximum. Meaningful only if it has one.",
    "queries.memberOf": "Whether this string is in the fixed set that field takes.",
    "queries.minimum": "That field's minimum. Meaningful only if it has one.",
    "states.ACTIVE": "In a slot whose fields are checked, with no given field being checked.",
    "states.CHECKING": "A given, declared field's value is being checked.",
    "states.INACTIVE": "In a slot whose fields are not checked (its target is unknown, or its shape is already wrong). Nothing is reported until the walk leaves it.",
    "states.OUTSIDE": "Between slots.",
    "states.SETTLED": "A given field has already been reported; what follows about its value is ignored."
  },
  "irVersion": 7,
