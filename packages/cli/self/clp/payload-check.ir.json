{
  "behaviors": [
    {
      "asks": {
        "bounded": {
          "input": {
            "effect": {
              "$ref": "data:effect"
            },
            "field": {
              "$ref": "data:field"
            }
          },
          "query": "hasMinimum"
        },
        "capped": {
          "input": {
            "effect": {
              "$ref": "data:effect"
            },
            "field": {
              "$ref": "data:field"
            }
          },
          "query": "hasMaximum"
        },
        "highest": {
          "input": {
            "effect": {
              "$ref": "data:effect"
            },
            "field": {
              "$ref": "data:field"
            }
          },
          "query": "maximum"
        },
        "inSet": {
          "input": {
            "effect": {
              "$ref": "data:effect"
            },
            "field": {
              "$ref": "data:field"
            },
            "value": {
              "$ref": "input:text"
            }
          },
          "query": "memberOf"
        },
        "lowest": {
          "input": {
            "effect": {
              "$ref": "data:effect"
            },
            "field": {
              "$ref": "data:field"
            }
          },
          "query": "minimum"
        },
        "takes": {
          "input": {
            "effect": {
              "$ref": "data:effect"
            },
            "field": {
              "$ref": "data:field"
            }
          },
          "query": "fieldKind"
        }
      },
      "description": "A concrete value for the field being walked. `kind` says what it is. `text` is the value when it is a string, and `number` is the value when it is an integer or a number; otherwise they carry nothing.",
      "from": [
        "IN_FIELD",
        "IN_SETTLED_FIELD",
        "IN_UNKNOWN_EFFECT"
      ],
      "name": "Constant",
      "onlyIf": [],
      "when": {
        "The field's value is still being checked, and the constant does not fit the field": {
          "does": "A bad-value diagnostic is reported for the remembered effect and field.",
          "effects": [
            {
              "name": "ReportDiagnostic",
              "payload": {
                "code": "bad-value",
                "effect": {
                  "$ref": "data:effect"
                },
                "field": {
                  "$ref": "data:field"
                }
              }
            }
          ],
          "goTo": "IN_SETTLED_FIELD"
        },
        "otherwise": {
          "effects": []
        }
      }
    },
    {
      "asks": {
        "given": {
          "input": {
            "effect": {
              "$ref": "data:effect"
            },
            "field": {
              "$ref": "input:name"
            }
          },
          "query": "fieldGiven"
        }
      },
      "description": "A field the effect being walked declares. The walk stays where it is.",
      "from": [
        "IN_EFFECT",
        "IN_UNKNOWN_EFFECT"
      ],
      "name": "DeclaredField",
      "onlyIf": [],
      "when": {
        "The effect is declared, and the specification gives no value for the declared field": {
          "does": "A missing-field diagnostic is reported for the effect and that field.",
          "effects": [
            {
              "name": "ReportDiagnostic",
              "payload": {
                "code": "missing-field",
                "effect": {
                  "$ref": "data:effect"
                },
                "field": {
                  "$ref": "input:name"
                }
              }
            }
          ]
        },
        "otherwise": {
          "effects": []
        }
      }
    },
    {
      "asks": {
        "declared": {
          "input": {
            "name": {
              "$ref": "input:name"
            }
          },
          "query": "effectDeclared"
        }
      },
      "description": "The walk enters an effect and remembers its name.",
      "from": [
        "OUTSIDE"
      ],
      "name": "EnterEffect",
      "onlyIf": [],
      "when": {
        "The entered effect is not declared": {
          "effects": [],
          "goTo": "IN_UNKNOWN_EFFECT",
          "set": {
            "effect": {
              "$ref": "input:name"
            }
          }
        },
        "otherwise": {
          "effects": [],
          "goTo": "IN_EFFECT",
          "set": {
            "effect": {
              "$ref": "input:name"
            }
          }
        }
      }
    },
    {
      "asks": {
        "declared": {
          "input": {
            "effect": {
              "$ref": "data:effect"
            },
            "field": {
              "$ref": "input:name"
            }
          },
          "query": "fieldDeclared"
        }
      },
      "description": "A field the specification gives to the effect being walked. What is known about its value follows.",
      "from": [
        "IN_EFFECT",
        "IN_FIELD",
        "IN_SETTLED_FIELD",
        "IN_UNKNOWN_EFFECT"
      ],
      "name": "GivenField",
      "onlyIf": [],
      "when": {
        "The effect is declared and declares the given field": {
          "does": "The walk remembers the field's name.",
          "effects": [],
          "goTo": "IN_FIELD",
          "set": {
            "field": {
              "$ref": "input:name"
            }
          }
        },
        "The effect is declared but does not declare the given field": {
          "does": "The walk remembers the field's name. A bad-value diagnostic is reported for the effect and that field.",
          "effects": [
            {
              "name": "ReportDiagnostic",
              "payload": {
                "code": "bad-value",
                "effect": {
                  "$ref": "data:effect"
                },
                "field": {
                  "$ref": "input:name"
                }
              }
            }
          ],
          "goTo": "IN_SETTLED_FIELD",
          "set": {
            "field": {
              "$ref": "input:name"
            }
          }
        },
        "otherwise": {
          "effects": []
        }
      }
    },
    {
      "from": [
        "IN_EFFECT",
        "IN_FIELD",
        "IN_SETTLED_FIELD",
        "IN_UNKNOWN_EFFECT"
      ],
      "name": "LeaveEffect",
      "onlyIf": [],
      "when": {
        "otherwise": {
          "effects": [],
          "goTo": "OUTSIDE"
        }
      }
    },
    {
      "asks": {
        "takes": {
          "input": {
            "effect": {
              "$ref": "data:effect"
            },
            "field": {
              "$ref": "data:field"
            }
          },
          "query": "fieldKind"
        }
      },
      "description": "A value for the field being walked that is known only by its type.",
      "from": [
        "IN_FIELD",
        "IN_SETTLED_FIELD",
        "IN_UNKNOWN_EFFECT"
      ],
      "name": "Typed",
      "onlyIf": [],
      "when": {
        "The field's value is still being checked, and a value of that type does not fit the field": {
          "does": "A bad-value diagnostic is reported for the remembered effect and field.",
          "effects": [
            {
              "name": "ReportDiagnostic",
              "payload": {
                "code": "bad-value",
                "effect": {
                  "$ref": "data:effect"
                },
                "field": {
                  "$ref": "data:field"
                }
              }
            }
          ],
          "goTo": "IN_SETTLED_FIELD"
        },
        "otherwise": {
          "effects": []
        }
      }
    },
    {
      "description": "The value given for the field being walked is a reference that points at nothing.",
      "from": [
        "IN_FIELD",
        "IN_SETTLED_FIELD",
        "IN_UNKNOWN_EFFECT"
      ],
      "name": "Unresolved",
      "onlyIf": [],
      "when": {
        "The field's value is still being checked": {
          "does": "A bad-value diagnostic is reported for the remembered effect and field.",
          "effects": [
            {
              "name": "ReportDiagnostic",
              "payload": {
                "code": "bad-value",
                "effect": {
                  "$ref": "data:effect"
                },
                "field": {
                  "$ref": "data:field"
                }
              }
            }
          ],
          "goTo": "IN_SETTLED_FIELD"
        },
        "otherwise": {
          "effects": []
        }
      }
    }
  ],
  "decisions": {
    "constantFit": {
      "rows": {
        "The field takes a boolean and the value is a boolean": {
          "fits": true
        },
        "The field takes a number, and the value is an integer or a number within the field's bounds": {
          "fits": true
        },
        "The field takes a string and the value is a string": {
          "fits": true
        },
        "The field takes an integer, and the value is an integer within the field's bounds": {
          "fits": true
        },
        "The field takes one of a fixed set of strings, and the value is a string in that set": {
          "fits": true
        },
        "otherwise": {
          "fits": false
        }
      }
    },
    "typeFit": {
      "rows": {
        "The value's type is integer and the field takes a number": {
          "fits": true
        },
        "The value's type is the same as what the field takes": {
          "fits": true
        },
        "otherwise": {
          "fits": false
        }
      }
    }
  },
  "descriptions": {
    "component": "Checks the payload a specification gives to an effect, one effect at a time, and reports every mismatch with the effect's declaration: a declared field that is not given, a given field that is not declared, and a given value that does not fit its field. For one given field at most one diagnostic is reported: the first. An effect that is not declared is reported elsewhere; its fields are not checked here.",
    "data.effect": "The name of the effect being walked.",
    "data.field": "The name of the given field being walked.",
    "effects.ReportDiagnostic": "A mismatch found in the effect being walked, for the named field.",
    "queries.effectDeclared": "Whether the specification declares an effect of this name.",
    "queries.fieldDeclared": "Whether that effect declares a field of this name.",
    "queries.fieldGiven": "Whether the specification gives a value for that field of that effect.",
    "queries.fieldKind": "What that field takes. \"enum\" means one of a fixed set of strings.",
    "queries.hasMaximum": "Whether that field has a maximum.",
    "queries.hasMinimum": "Whether that field has a minimum.",
    "queries.maximum": "That field's maximum. Meaningful only if it has one.",
    "queries.memberOf": "Whether this string is in the fixed set that field takes.",
    "queries.minimum": "That field's minimum. Meaningful only if it has one.",
    "states.IN_EFFECT": "In a declared effect, before any given field.",
    "states.IN_FIELD": "In a given field of a declared effect whose value is still being checked.",
    "states.IN_SETTLED_FIELD": "In a given field for which a diagnostic has already been reported. What follows about its value is ignored.",
    "states.IN_UNKNOWN_EFFECT": "In an effect that is not declared. Nothing is checked and nothing is reported until the walk leaves it.",
    "states.OUTSIDE": "Between effects."
  },
  "irVersion": 5,
