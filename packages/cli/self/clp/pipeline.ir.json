{
  "behaviors": [
    {
      "from": [
        "GRADING"
      ],
      "name": "CurrentCodeGraded",
      "onlyIf": [],
      "when": {
        "The check passed": {
          "does": "Nothing: there is nothing to implement.",
          "goTo": "DONE"
        },
        "otherwise": {
          "does": "An implementation session is started (attempt 1).",
          "emits": [
            {
              "effect": "StartSession",
              "input": {
                "attempt": 1,
                "phase": "implementation",
                "round": {
                  "$ref": "data:round"
                }
              }
            }
          ],
          "goTo": "IMPLEMENTATION"
        }
      }
    },
    {
      "from": [
        "DESIGN"
      ],
      "name": "DesignChecked",
      "onlyIf": [],
      "when": {
        "(not \"The check passed\" and \"Attempts remain in this phase\")": {
          "does": "The attempt number goes up by one. A session of the same phase is started with the new attempt number.",
          "emits": [
            {
              "effect": "StartSession",
              "input": {
                "attempt": {
                  "$ref": "calculation:nextAttempt"
                },
                "phase": "design",
                "round": {
                  "$ref": "data:round"
                }
              }
            }
          ],
          "set": {
            "attempt": {
              "$ref": "calculation:nextAttempt"
            }
          }
        },
        "(not \"The check passed\" and not \"Attempts remain in this phase\" and \"Rounds remain\")": {
          "does": "The round number goes up by one and the attempt number goes back to 1. The code is discarded if it was being written from nothing. Then a design session is started in the new round.",
          "emits": [
            {
              "effect": "DiscardCode",
              "input": {},
              "onlyWhen": "The code is being written from nothing"
            },
            {
              "effect": "StartSession",
              "input": {
                "attempt": 1,
                "phase": "design",
                "round": {
                  "$ref": "calculation:nextRound"
                }
              }
            }
          ],
          "goTo": "DESIGN",
          "set": {
            "attempt": 1,
            "round": {
              "$ref": "calculation:nextRound"
            }
          }
        },
        "The check passed": {
          "does": "The attempt number goes back to 1. A wiring session is started.",
          "emits": [
            {
              "effect": "StartSession",
              "input": {
                "attempt": 1,
                "phase": "wiring",
                "round": {
                  "$ref": "data:round"
                }
              }
            }
          ],
          "goTo": "WIRING",
          "set": {
            "attempt": 1
          }
        },
        "otherwise": {
          "goTo": "FAILED"
        }
      }
    },
    {
      "from": [
        "IMPLEMENTATION"
      ],
      "name": "ImplementationChecked",
      "onlyIf": [],
      "when": {
        "(not \"The check passed\" and \"Attempts remain in this phase\")": {
          "does": "The attempt number goes up by one. A session of the same phase is started with the new attempt number.",
          "emits": [
            {
              "effect": "StartSession",
              "input": {
                "attempt": {
                  "$ref": "calculation:nextAttempt"
                },
                "phase": "implementation",
                "round": {
                  "$ref": "data:round"
                }
              }
            }
          ],
          "set": {
            "attempt": {
              "$ref": "calculation:nextAttempt"
            }
          }
        },
        "(not \"The check passed\" and not \"Attempts remain in this phase\" and \"Rounds remain\")": {
          "does": "The round number goes up by one and the attempt number goes back to 1. The code is discarded if it was being written from nothing. Then a design session is started in the new round.",
          "emits": [
            {
              "effect": "DiscardCode",
              "input": {},
              "onlyWhen": "The code is being written from nothing"
            },
            {
              "effect": "StartSession",
              "input": {
                "attempt": 1,
                "phase": "design",
                "round": {
                  "$ref": "calculation:nextRound"
                }
              }
            }
          ],
          "goTo": "DESIGN",
          "set": {
            "attempt": 1,
            "round": {
              "$ref": "calculation:nextRound"
            }
          }
        },
        "The check passed": {
          "goTo": "DONE"
        },
        "otherwise": {
          "goTo": "FAILED"
        }
      }
    },
    {
      "description": "The pipeline remembers the two limits and whether the plan is incremental, and that this is round 1, attempt 1. Then a session of the plan's phase is started; where the plan has no phase, the current code is graded instead.",
      "from": [
        "IDLE"
      ],
      "name": "Start",
      "onlyIf": [],
      "when": {
        "otherwise": {
          "emits": [
            {
              "effect": "StartSession",
              "input": {
                "attempt": 1,
                "phase": {
                  "$ref": "decision:plan.phase"
                },
                "round": 1
              },
              "onlyWhen": "The plan has a phase"
            },
            {
              "effect": "GradeCurrentCode",
              "input": {
                "round": 1
              },
              "onlyWhen": "The plan has no phase"
            }
          ],
          "goTo": {
            "$ref": "decision:plan.next"
          },
          "set": {
            "attempt": 1,
            "incremental": {
              "$ref": "decision:plan.incremental"
            },
            "maxAttempts": {
              "$ref": "input:attemptsPerPhase"
            },
            "maxRounds": {
              "$ref": "input:rounds"
            },
            "round": 1
          }
        }
      }
    },
    {
      "from": [
        "WIRING"
      ],
      "name": "WiringChecked",
      "onlyIf": [],
      "when": {
        "(\"The check passed\" and \"Existing code is being changed (the code was not written from nothing)\")": {
          "does": "The attempt number goes back to 1. The current code is graded.",
          "emits": [
            {
              "effect": "GradeCurrentCode",
              "input": {
                "round": {
                  "$ref": "data:round"
                }
              }
            }
          ],
          "goTo": "GRADING",
          "set": {
            "attempt": 1
          }
        },
        "(\"The check passed\" and not \"Existing code is being changed (the code was not written from nothing)\")": {
          "does": "The attempt number goes back to 1. An implementation session is started.",
          "emits": [
            {
              "effect": "StartSession",
              "input": {
                "attempt": 1,
                "phase": "implementation",
                "round": {
                  "$ref": "data:round"
                }
              }
            }
          ],
          "goTo": "IMPLEMENTATION",
          "set": {
            "attempt": 1
          }
        },
        "(not \"The check passed\" and \"Attempts remain in this phase\")": {
          "does": "The attempt number goes up by one. A session of the same phase is started with the new attempt number.",
          "emits": [
            {
              "effect": "StartSession",
              "input": {
                "attempt": {
                  "$ref": "calculation:nextAttempt"
                },
                "phase": "wiring",
                "round": {
                  "$ref": "data:round"
                }
              }
            }
          ],
          "set": {
            "attempt": {
              "$ref": "calculation:nextAttempt"
            }
          }
        },
        "(not \"The check passed\" and not \"Attempts remain in this phase\" and \"Rounds remain\")": {
          "does": "The round number goes up by one and the attempt number goes back to 1. The code is discarded if it was being written from nothing. Then a design session is started in the new round.",
          "emits": [
            {
              "effect": "DiscardCode",
              "input": {},
              "onlyWhen": "The code is being written from nothing"
            },
            {
              "effect": "StartSession",
              "input": {
                "attempt": 1,
                "phase": "design",
                "round": {
                  "$ref": "calculation:nextRound"
                }
              }
            }
          ],
          "goTo": "DESIGN",
          "set": {
            "attempt": 1,
            "round": {
              "$ref": "calculation:nextRound"
            }
          }
        },
        "otherwise": {
          "goTo": "FAILED"
        }
      }
    }
  ],
  "conditions": {
    "(\"The check passed\" and \"Existing code is being changed (the code was not written from nothing)\")": {
      "all": [
        "The check passed",
        "Existing code is being changed (the code was not written from nothing)"
      ]
    },
    "(\"The check passed\" and not \"Existing code is being changed (the code was not written from nothing)\")": {
      "all": [
        "The check passed",
        "not \"Existing code is being changed (the code was not written from nothing)\""
      ]
    },
    "(not \"The check passed\" and \"Attempts remain in this phase\")": {
      "all": [
        "not \"The check passed\"",
        "Attempts remain in this phase"
      ]
    },
    "(not \"The check passed\" and not \"Attempts remain in this phase\" and \"Rounds remain\")": {
      "all": [
        "not \"The check passed\"",
        "not \"Attempts remain in this phase\"",
        "Rounds remain"
      ]
    },
    "not \"Attempts remain in this phase\"": {
      "not": "Attempts remain in this phase"
    },
    "not \"Existing code is being changed (the code was not written from nothing)\"": {
      "not": "Existing code is being changed (the code was not written from nothing)"
    },
    "not \"The check passed\"": {
      "not": "The check passed"
    }
  },
  "decisions": {
    "plan": {
      "rows": {
        "There is no production code yet": {
          "incremental": false,
          "next": "DESIGN",
          "phase": "design"
        },
        "There is production code, and the boundary differs from the previous run": {
          "incremental": true,
          "next": "DESIGN",
          "phase": "design"
        },
        "There is production code, the boundary is unchanged, and there is no adapter": {
          "incremental": true,
          "next": "WIRING",
          "phase": "wiring"
        },
        "otherwise": {
          "incremental": true,
          "next": "GRADING",
          "phase": null
        }
      }
    }
  },
  "descriptions": {
    "component": "Reconciles one component with its specification in up to three phases (design, wiring, implementation). Each phase is an agent session followed by a check. A rejected check repeats the phase; a phase that runs out of attempts restarts the pipeline from design, until the rounds run out.",
    "effects.GradeCurrentCode": "Grade the production code as it is, without an agent.",
    "queries.boundaryChanged": "Whether the component's boundary differs from the one the previous run worked from."
  },
  "irVersion": 7,
  "model": {
    "calculations": {
      "nextAttempt": {
        "description": "the current attempt number plus one",
        "output": "integer"
      },
      "nextRound": {
        "description": "the current round number plus one",
        "output": "integer"
      }
    },
    "commands": {
      "CurrentCodeGraded": {
        "passed": "boolean"
      },
      "DesignChecked": {
        "passed": "boolean"
      },
      "ImplementationChecked": {
        "passed": "boolean"
      },
      "Start": {
        "attemptsPerPhase": {
          "max": 3,
          "min": 1,
          "type": "integer"
        },
        "rounds": {
          "max": 3,
          "min": 1,
          "type": "integer"
        }
      },
      "WiringChecked": {
        "passed": "boolean"
      }
    },
    "data": {
      "attempt": {
        "max": 4,
        "min": 1,
        "type": "integer"
      },
      "incremental": "boolean",
      "maxAttempts": {
        "max": 3,
        "min": 1,
        "type": "integer"
      },
      "maxRounds": {
        "max": 3,
        "min": 1,
        "type": "integer"
      },
      "round": {
        "max": 4,
        "min": 1,
        "type": "integer"
      }
    },
    "effects": {
      "DiscardCode": {},
      "GradeCurrentCode": {
        "round": {
          "max": 4,
          "min": 1,
          "type": "integer"
        }
      },
      "StartSession": {
        "attempt": {
          "max": 4,
          "min": 1,
          "type": "integer"
        },
        "phase": [
          "design",
          "wiring",
          "implementation"
        ],
        "round": {
          "max": 4,
          "min": 1,
          "type": "integer"
        }
      }
    },
    "init": "IDLE",
    "invariants": [
      "The attempt number never exceeds the limit of attempts per phase",
      "The round number never exceeds the limit of rounds"
    ],
    "queries": {
      "boundaryChanged": {
        "input": {},
        "output": "boolean"
      },
      "hasAdapter": {
        "input": {},
        "output": "boolean"
      },
      "hasProductionCode": {
        "input": {},
        "output": "boolean"
      }
    },
    "states": [
      "IDLE",
      "DESIGN",
      "WIRING",
      "GRADING",
      "IMPLEMENTATION",
      "DONE",
      "FAILED"
    ]
  }
}
