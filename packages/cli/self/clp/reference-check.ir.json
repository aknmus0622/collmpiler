{
  "behaviors": [
    {
      "asks": {
        "declared": {
          "input": {
            "name": {
              "$ref": "input:state"
            }
          },
          "query": "stateDeclared"
        }
      },
      "from": [
        "IN_COMMAND"
      ],
      "name": "AllowFrom",
      "onlyIf": [],
      "when": {
        "The named state is not declared": {
          "does": "An unknown-state diagnostic is reported for the remembered command, with an empty case name and the state as the subject. The walk remembers that something was reported.",
          "effects": [
            {
              "name": "ReportDiagnostic",
              "payload": {
                "caseName": "",
                "code": "unknown-state",
                "command": {
                  "$ref": "data:command"
                },
                "subject": {
                  "$ref": "input:state"
                }
              }
            }
          ],
          "set": {
            "reported": true
          }
        },
        "otherwise": {
          "effects": []
        }
      }
    },
    {
      "from": [
        "IDLE"
      ],
      "name": "Begin",
      "onlyIf": [],
      "when": {
        "otherwise": {
          "does": "Nothing has been reported yet.",
          "effects": [],
          "goTo": "BETWEEN_COMMANDS",
          "set": {
            "reported": false
          }
        }
      }
    },
    {
      "from": [
        "IN_COMMAND",
        "IN_CASE"
      ],
      "name": "EnterCase",
      "onlyIf": [],
      "when": {
        "otherwise": {
          "does": "The walk remembers the case's name.",
          "effects": [],
          "goTo": "IN_CASE",
          "set": {
            "caseName": {
              "$ref": "input:name"
            }
          }
        }
      }
    },
    {
      "from": [
        "BETWEEN_COMMANDS"
      ],
      "name": "EnterCommand",
      "onlyIf": [],
      "when": {
        "otherwise": {
          "does": "The walk remembers the command's name, and an empty case name.",
          "effects": [],
          "goTo": "IN_COMMAND",
          "set": {
            "caseName": "",
            "command": {
              "$ref": "input:name"
            }
          }
        }
      }
    },
    {
      "description": "Between commands, the walk can be finished: it is accepted if nothing was reported, rejected otherwise.",
      "from": [
        "BETWEEN_COMMANDS"
      ],
      "name": "Finish",
      "onlyIf": [],
      "when": {
        "Nothing was reported": {
          "effects": [],
          "goTo": "ACCEPTED"
        },
        "otherwise": {
          "effects": [],
          "goTo": "REJECTED"
        }
      }
    },
    {
      "asks": {
        "declared": {
          "input": {
            "name": {
              "$ref": "input:state"
            }
          },
          "query": "stateDeclared"
        }
      },
      "from": [
        "IN_CASE"
      ],
      "name": "GoTo",
      "onlyIf": [],
      "when": {
        "The named state is not declared": {
          "does": "An unknown-state diagnostic is reported for the remembered command and case, with the state as the subject. The walk remembers that something was reported.",
          "effects": [
            {
              "name": "ReportDiagnostic",
              "payload": {
                "caseName": {
                  "$ref": "data:caseName"
                },
                "code": "unknown-state",
                "command": {
                  "$ref": "data:command"
                },
                "subject": {
                  "$ref": "input:state"
                }
              }
            }
          ],
          "set": {
            "reported": true
          }
        },
        "otherwise": {
          "effects": []
        }
      }
    },
    {
      "from": [
        "IN_COMMAND",
        "IN_CASE"
      ],
      "name": "LeaveCommand",
      "onlyIf": [],
      "when": {
        "otherwise": {
          "effects": [],
          "goTo": "BETWEEN_COMMANDS"
        }
      }
    },
    {
      "asks": {
        "declared": {
          "input": {
            "name": {
              "$ref": "input:name"
            }
          },
          "query": "effectDeclared"
        }
      },
      "from": [
        "IN_CASE"
      ],
      "name": "UseEffect",
      "onlyIf": [],
      "when": {
        "The named effect is not declared": {
          "does": "An unknown-effect diagnostic is reported for the remembered command and case, with the effect as the subject. The walk remembers that something was reported.",
          "effects": [
            {
              "name": "ReportDiagnostic",
              "payload": {
                "caseName": {
                  "$ref": "data:caseName"
                },
                "code": "unknown-effect",
                "command": {
                  "$ref": "data:command"
                },
                "subject": {
                  "$ref": "input:name"
                }
              }
            }
          ],
          "set": {
            "reported": true
          }
        },
        "otherwise": {
          "effects": []
        }
      }
    }
  ],
  "decisions": {},
  "descriptions": {
    "component": "Walks the commands of a specification, one element at a time, and reports every reference to a state or an effect that is not declared. At the end the walk is accepted if nothing was reported, rejected otherwise.",
    "queries.effectDeclared": "Whether the specification declares an effect of this name.",
    "queries.stateDeclared": "Whether the specification declares a state of this name."
  },
  "irVersion": 5,
  "model": {
    "commands": {
      "AllowFrom": {
        "state": "string"
      },
      "Begin": {},
      "EnterCase": {
        "name": "string"
      },
      "EnterCommand": {
        "name": "string"
      },
      "Finish": {},
      "GoTo": {
        "state": "string"
      },
      "LeaveCommand": {},
      "UseEffect": {
        "name": "string"
      }
    },
    "data": {
      "caseName": "string",
      "command": "string",
      "reported": "boolean"
    },
    "effects": {
      "ReportDiagnostic": {
        "caseName": "string",
        "code": [
          "unknown-state",
          "unknown-effect"
        ],
        "command": "string",
        "subject": "string"
      }
    },
    "init": "IDLE",
    "invariants": [
      "A walk that has started remembers whether something was reported"
    ],
    "queries": {
      "effectDeclared": {
        "input": {
          "name": "string"
        },
        "output": "boolean"
      },
      "stateDeclared": {
        "input": {
          "name": "string"
        },
        "output": "boolean"
      }
    },
    "states": [
      "IDLE",
      "BETWEEN_COMMANDS",
      "IN_COMMAND",
      "IN_CASE",
      "ACCEPTED",
      "REJECTED"
    ]
  }
}
