{
  "behaviors": [
    {
      "calls": {
        "todos.Complete": {
          "command": "Complete",
          "input": {
            "id": {
              "$ref": "input:id"
            }
          },
          "part": "todos"
        }
      },
      "description": "The item is completed in the list. Completed: 200. Not found: 404. Already done: 409.",
      "from": [
        "READY"
      ],
      "name": "CompleteTodo",
      "onlyIf": [],
      "when": {
        "The list found no item with the given identifier to complete.": {
          "responds": {
            "status": 404
          }
        },
        "The list found that the item with the given identifier is already done.": {
          "responds": {
            "status": 409
          }
        },
        "otherwise": {
          "responds": {
            "status": 200
          }
        }
      }
    },
    {
      "calls": {
        "todos.Remove": {
          "command": "Remove",
          "input": {
            "id": {
              "$ref": "input:id"
            }
          },
          "part": "todos"
        }
      },
      "description": "The item is removed from the list. Removed: 204. Not found: 404.",
      "from": [
        "READY"
      ],
      "name": "DeleteTodo",
      "onlyIf": [],
      "when": {
        "The list found no item with the given identifier to remove.": {
          "responds": {
            "status": 404
          }
        },
        "otherwise": {
          "responds": {
            "status": 204
          }
        }
      }
    },
    {
      "calls": {
        "todos.List": {
          "command": "List",
          "input": {
            "only": {
              "$ref": "input:only"
            }
          },
          "part": "todos"
        }
      },
      "from": [
        "READY"
      ],
      "name": "GetTodos",
      "onlyIf": [],
      "when": {
        "otherwise": {
          "does": "The list's items, filtered as asked, are the body, with 200.",
          "responds": {
            "body": {
              "$ref": "call",
              "path": [
                "todos.List"
              ]
            },
            "status": 200
          }
        }
      }
    },
    {
      "calls": {
        "todos.Add": {
          "command": "Add",
          "input": {
            "title": {
              "$ref": "input:body.title"
            }
          },
          "part": "todos"
        }
      },
      "description": "The title in the body is added to the list. Created: 201, with the new item. Invalid: 422, with no body.",
      "from": [
        "READY"
      ],
      "name": "PostTodos",
      "onlyIf": [],
      "when": {
        "The list refused the title as invalid.": {
          "responds": {
            "body": null,
            "status": 422
          }
        },
        "otherwise": {
          "responds": {
            "body": {
              "$ref": "call",
              "path": [
                "todos.Add",
                "todo"
              ]
            },
            "status": 201
          }
        }
      }
    }
  ],
  "decisions": {},
  "descriptions": {
