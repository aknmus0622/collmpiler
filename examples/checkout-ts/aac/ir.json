{
  "behaviors": [
    {
      "from": [
        "PENDING",
        "PAID"
      ],
      "name": "Cancel",
      "preconditions": [],
      "transitions": {
        "Cancelled": {
          "emittedCommands": [
            {
              "$spread": "decision:CancelRules.effects"
            }
          ],
          "event": "Order cancelled",
          "nextState": "CANCELLED"
        }
      }
    },
    {
      "from": [
        "PENDING"
      ],
      "name": "Checkout",
      "preconditions": [
        "外部決済モジュールが有効な場合"
      ],
      "transitions": {
        "PaymentFailure": {
          "emittedCommands": [
            {
              "action": "NotifyPaymentFailure",
              "payload": {},
              "payloadSchema": {}
            }
          ],
          "event": "Payment failed",
          "nextState": "PENDING"
        },
        "PaymentSuccess": {
          "emittedCommands": [
            {
              "action": "SendReceipt",
              "payload": {
                "discount": {
                  "$ref": "decision:CampaignRules.discount"
                }
              },
              "payloadSchema": {
                "discount": "number"
              }
            },
            {
              "$spread": "decision:CampaignRules.effects"
            }
          ],
          "event": "Payment completed",
          "nextState": "PAID"
        }
      }
    },
    {
      "from": [
        "PAID"
      ],
      "name": "Ship",
      "preconditions": [],
      "transitions": {
        "Shipped": {
          "emittedCommands": [
            {
              "action": "SendShippingNotice",
              "payload": {},
              "payloadSchema": {}
            }
          ],
          "event": "Order shipped",
          "nextState": "SHIPPED"
        }
      }
    }
  ],
  "decisions": {
    "CampaignRules": {
      "bound": true,
      "rows": {
        "default": {
          "discount": 0,
          "effects": []
        },
        "ゴールド会員であり、かつ月末の場合": {
          "discount": 0.2,
          "effects": [
            {
              "action": "IssueCoupon",
              "payload": {
                "type": "Premium"
              }
            }
          ]
        },
        "シルバー会員の場合": {
          "discount": 0.05,
          "effects": []
        }
      }
    },
    "CancelRules": {
      "bound": true,
      "rows": {
        "default": {
          "effects": []
        },
        "決済済みの注文の場合": {
          "effects": [
            {
              "action": "Refund",
              "payload": {}
            }
          ]
        }
      }
    }
  },
  "irVersion": 1,
  "model": {
    "commands": {
      "IssueCoupon": {
        "type": [
          "Premium",
          "Standard"
        ]
      },
      "NotifyPaymentFailure": {},
      "Refund": {},
      "SendReceipt": {
        "discount": "number"
      },
      "SendShippingNotice": {}
    },
    "initial": "PENDING",
    "input": {
      "rank": [
        "Gold",
        "Silver",
        "Bronze"
      ]
    },
    "queries": {
      "isMonthEnd": "boolean",
      "paymentModuleActive": "boolean"
    },
    "states": [
      "PENDING",
      "PAID",
      "SHIPPED",
      "CANCELLED"
    ]
  }
}
