{
  "behaviors": [
    {
      "from": [
        "PENDING",
        "PAID"
      ],
      "name": "Cancel",
      "preconditions": [],
      "transitions": {
        "default": {
          "emittedCommands": [
            {
              "$spread": "decision:CancelRules.effects"
            }
          ],
          "event": "Order cancelled",
          "nextState": "CANCELLED"
        }
      }
    },
    {
      "from": [
        "PENDING"
      ],
      "name": "Checkout",
      "preconditions": [
        "外部決済モジュールが有効な場合"
      ],
      "transitions": {
        "default": {
          "emittedCommands": [
            {
              "action": "NotifyPaymentFailure",
              "payload": {},
              "payloadSchema": {}
            }
          ],
          "event": "Payment failed",
          "nextState": "PENDING"
        },
        "決済に成功した場合": {
          "emittedCommands": [
            {
              "action": "SendReceipt",
              "payload": {
                "amount": {
                  "$ref": "formula:請求金額（価格 ×（100 − 割引率）÷ 100、1円未満切り捨て）"
                },
                "discountPercent": {
                  "$ref": "decision:CampaignRules.discountPercent"
                }
              },
              "payloadSchema": {
                "amount": "integer",
                "discountPercent": "number"
              }
            },
            {
              "$spread": "decision:CampaignRules.effects"
            }
          ],
          "event": "Payment completed",
          "nextState": "PAID"
        }
      }
    },
    {
      "from": [
        "DRAFT"
      ],
      "name": "PlaceOrder",
      "preconditions": [],
      "transitions": {
        "default": {
          "emittedCommands": [
            {
              "action": "SendOrderConfirmation",
              "payload": {},
              "payloadSchema": {}
            }
          ],
          "event": "Order placed",
          "nextState": "PENDING",
          "set": {
            "price": {
              "$ref": "input:listPrice"
            },
            "rank": {
              "$ref": "input:customerRank"
            }
          }
        }
      }
    },
    {
      "from": [
        "PAID"
      ],
      "name": "Ship",
      "preconditions": [],
      "transitions": {
        "default": {
          "emittedCommands": [
            {
              "action": "SendShippingNotice",
              "payload": {
                "priority": {
                  "$ref": "decision:ShippingRules.priority"
                }
              },
              "payloadSchema": {
                "priority": "boolean"
              }
            }
          ],
          "event": "Order shipped",
          "nextState": "SHIPPED"
        }
      }
    }
  ],
  "decisions": {
    "CampaignRules": {
      "bound": true,
      "rows": {
        "default": {
          "discountPercent": 0,
          "effects": []
        },
        "ゴールド会員であり、かつ月末の場合": {
          "discountPercent": 20,
          "effects": [
            {
              "action": "IssueCoupon",
              "payload": {
                "type": "Premium"
              }
            }
          ]
        },
        "シルバー会員の場合": {
          "discountPercent": 5,
          "effects": []
        }
      }
    },
    "CancelRules": {
      "bound": true,
      "rows": {
        "default": {
          "effects": []
        },
        "決済済みの注文の場合": {
          "effects": [
            {
              "action": "Refund",
              "payload": {}
            }
          ]
        }
      }
    },
    "ShippingRules": {
      "bound": true,
      "rows": {
        "default": {
          "priority": false
        },
        "ゴールド会員、または1万円以上の注文の場合": {
          "priority": true
        }
      }
    }
  },
  "irVersion": 1,
  "model": {
    "actions": {
      "Cancel": {},
      "Checkout": {},
      "PlaceOrder": {
        "customerRank": [
          "Gold",
          "Silver",
          "Bronze"
        ],
        "listPrice": {
          "around": [
            10000
          ],
          "max": 1000000,
          "min": 0,
          "type": "integer"
        }
      },
      "Ship": {}
    },
    "commands": {
      "IssueCoupon": {
        "type": [
          "Premium",
          "Standard"
        ]
      },
      "NotifyPaymentFailure": {},
      "Refund": {},
      "SendOrderConfirmation": {},
      "SendReceipt": {
        "amount": "integer",
        "discountPercent": "integer"
      },
      "SendShippingNotice": {
        "priority": "boolean"
      }
    },
    "data": {
      "price": {
        "around": [
          10000
        ],
        "max": 1000000,
        "min": 0,
        "type": "integer"
      },
      "rank": [
        "Gold",
        "Silver",
        "Bronze"
      ]
    },
    "formulas": {
      "請求金額（価格 ×（100 − 割引率）÷ 100、1円未満切り捨て）": "integer"
    },
    "initial": "DRAFT",
    "invariants": [
      "下書き以外の注文には、会員ランクと価格が設定されている"
    ],
    "queries": {
      "isMonthEnd": "boolean",
      "paymentModuleActive": "boolean",
      "paymentResult": [
        "succeeded",
        "failed"
      ]
    },
    "states": [
      "DRAFT",
      "PENDING",
      "PAID",
      "SHIPPED",
      "CANCELLED"
    ]
  }
}
