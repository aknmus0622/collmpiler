{
  "behaviors": [
    {
      "description": "A pending or paid order can be cancelled. If the order had been paid, a refund is issued.",
      "from": [
        "PENDING",
        "PAID"
      ],
      "name": "Cancel",
      "onlyIf": [],
      "when": {
        "otherwise": {
          "effects": [
            {
              "name": "Refund",
              "payload": {},
              "when": {
                "$was": [
                  "PAID"
                ]
              }
            }
          ],
          "goTo": "CANCELLED"
        }
      }
    },
    {
      "from": [
        "PENDING"
      ],
      "name": "Checkout",
      "onlyIf": [
        "The external payment module is active"
      ],
      "when": {
        "The payment succeeded": {
          "does": "A receipt is sent with the campaign's discount percent and the amount charged. Then a coupon is issued if the campaign grants one.",
          "effects": [
            {
              "name": "SendReceipt",
              "payload": {
                "amount": {
                  "$ref": "calculation:amountCharged"
                },
                "discountPercent": {
                  "$ref": "decision:campaign.discountPercent"
                }
              }
            },
            {
              "name": "IssueCoupon",
              "payload": {
                "type": {
                  "$ref": "decision:campaign.coupon"
                }
              },
              "when": {
                "$ref": "decision:campaign.grantsCoupon"
              }
            }
          ],
          "goTo": "PAID"
        },
        "otherwise": {
          "does": "The customer is notified of the payment failure.",
          "effects": [
            {
              "name": "NotifyPaymentFailure",
              "payload": {}
            }
          ]
        }
      }
    },
    {
      "from": [
        "DRAFT"
      ],
      "name": "PlaceOrder",
      "onlyIf": [],
      "when": {
        "otherwise": {
          "does": "The order remembers the customer's rank and the list price. An order confirmation is sent.",
          "effects": [
            {
              "name": "SendOrderConfirmation",
              "payload": {}
            }
          ],
          "goTo": "PENDING",
          "set": {
            "price": {
              "$ref": "input:listPrice"
            },
            "rank": {
              "$ref": "input:customerRank"
            }
          }
        }
      }
    },
    {
      "from": [
        "PAID"
      ],
      "name": "Ship",
      "onlyIf": [],
      "when": {
        "otherwise": {
          "does": "The order becomes shipped. A shipping notice is sent, with priority as the shipping decision says.",
          "effects": [
            {
              "name": "SendShippingNotice",
              "payload": {
                "priority": {
                  "$ref": "decision:shipping.priority"
                }
              }
            }
          ],
          "goTo": "SHIPPED"
        }
      }
    }
  ],
  "decisions": {
    "campaign": {
      "rows": {
        "The customer is a Gold member and it is month-end": {
          "coupon": "Premium",
          "discountPercent": 20,
          "grantsCoupon": true
        },
        "The customer is a Silver member": {
          "coupon": null,
          "discountPercent": 5,
          "grantsCoupon": false
        },
        "otherwise": {
          "coupon": null,
          "discountPercent": 0,
          "grantsCoupon": false
        }
      }
    },
    "shipping": {
      "rows": {
        "The customer is a Gold member, or the order is 10,000 yen or more": {
          "priority": true
        },
        "otherwise": {
          "priority": false
        }
      }
    }
  },
  "descriptions": {
    "component": "An order: placed by a customer, paid through an external payment module, then shipped or cancelled.",
    "effects.Refund": "What the customer paid is returned.",
    "queries.isMonthEnd": "Whether today is the last day of the month.",
    "queries.paymentResult": "What the payment module answered for this order."
  },
  "irVersion": 5,
  "model": {
    "calculations": {
      "amountCharged": {
        "is": "price × (100 − discount percent) ÷ 100, rounded down to a whole yen",
        "type": "integer"
      }
    },
    "commands": {
      "Cancel": {},
      "Checkout": {},
      "PlaceOrder": {
        "customerRank": [
          "Gold",
          "Silver",
          "Bronze"
        ],
        "listPrice": {
          "around": [
            10000
          ],
          "max": 1000000,
          "min": 0,
          "type": "integer"
        }
      },
      "Ship": {}
    },
    "data": {
      "price": {
        "around": [
          10000
        ],
        "max": 1000000,
        "min": 0,
        "type": "integer"
      },
      "rank": [
        "Gold",
        "Silver",
        "Bronze"
      ]
    },
    "effects": {
      "IssueCoupon": {
        "type": [
          "Premium",
          "Standard"
        ]
      },
      "NotifyPaymentFailure": {},
      "Refund": {},
      "SendOrderConfirmation": {},
      "SendReceipt": {
        "amount": "integer",
        "discountPercent": "integer"
      },
      "SendShippingNotice": {
        "priority": "boolean"
      }
    },
    "init": "DRAFT",
    "invariants": [
      "Every order past the draft state has a member rank and a price"
    ],
    "queries": {
      "isMonthEnd": {
        "input": {},
        "output": "boolean"
      },
      "paymentModuleActive": {
        "input": {},
        "output": "boolean"
      },
      "paymentResult": {
        "input": {},
        "output": [
          "succeeded",
          "failed"
        ]
      }
    },
    "states": [
      "DRAFT",
      "PENDING",
      "PAID",
      "SHIPPED",
      "CANCELLED"
    ]
  }
}
