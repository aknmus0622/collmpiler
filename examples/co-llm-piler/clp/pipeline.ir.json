          "goTo": "IMPLEMENTATION",
          "set": {
            "attempt": {
              "$ref": "calculation:nextAttempt"
            }
          }
        },
        "The check was rejected, no attempts remain in this phase, and rounds remain": {
          "does": "The round number goes up by one and the attempt number goes back to 1. The code is discarded if it was being written from nothing. Then a design session is started in the new round.",
          "effects": [
            {
              "name": "DiscardCode",
              "payload": {},
              "when": "The code is being written from nothing"
            },
            {
              "name": "StartSession",
              "payload": {
                "attempt": 1,
                "phase": "design",
                "round": {
                  "$ref": "calculation:nextRound"
                }
              }
            }
          ],
          "goTo": "DESIGN",
          "set": {
            "attempt": 1,
            "round": {
              "$ref": "calculation:nextRound"
            }
          }
        },
        "otherwise": {
          "does": "Nothing.",
          "effects": [],
          "goTo": "FAILED"
        }
      }
    },
    {
      "from": [
        "IDLE"
      ],
      "name": "Start",
      "onlyIf": [],
      "when": {
        "There is no production code yet": {
          "does": "The pipeline remembers the two limits and whether the plan is incremental, and that this is round 1, attempt 1. A session of the plan's phase is started.",
          "effects": [
            {
              "name": "StartSession",
              "payload": {
                "attempt": 1,
                "phase": {
                  "$ref": "decision:plan.phase"
                },
                "round": 1
              }
            }
          ],
          "goTo": "DESIGN",
          "set": {
            "attempt": 1,
            "incremental": {
              "$ref": "decision:plan.incremental"
            },
            "maxAttempts": {
              "$ref": "input:attemptsPerPhase"
            },
            "maxRounds": {
              "$ref": "input:rounds"
            },
            "round": 1
          }
        },
        "There is production code, and the boundary differs from the previous run": {
          "does": "The pipeline remembers the two limits and whether the plan is incremental, and that this is round 1, attempt 1. A session of the plan's phase is started.",
          "effects": [
            {
              "name": "StartSession",
              "payload": {
                "attempt": 1,
