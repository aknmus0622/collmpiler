            },
            "maxRounds": {
              "$ref": "input:rounds"
            },
            "round": 1
          }
        },
        "otherwise": {
          "does": "The pipeline remembers the two limits and whether the plan is incremental, and that this is round 1, attempt 1. The current code is graded.",
          "effects": [
            {
              "name": "GradeCurrentCode",
              "payload": {
                "round": 1
              }
            }
          ],
          "goTo": "GRADING",
          "set": {
            "attempt": 1,
            "incremental": {
              "$ref": "decision:plan.incremental"
            },
            "maxAttempts": {
              "$ref": "input:attemptsPerPhase"
            },
            "maxRounds": {
              "$ref": "input:rounds"
            },
            "round": 1
          }
        }
      }
    },
    {
      "from": [
        "WIRING"
      ],
      "name": "WiringChecked",
      "onlyIf": [],
      "when": {
        "The check passed and existing code is being changed": {
          "does": "The attempt number goes back to 1. The current code is graded.",
          "effects": [
            {
              "name": "GradeCurrentCode",
              "payload": {
                "round": {
                  "$ref": "data:round"
                }
              }
            }
          ],
          "goTo": "GRADING",
          "set": {
            "attempt": 1
          }
        },
        "The check passed and the code is being written from nothing": {
          "does": "The attempt number goes back to 1. An implementation session is started.",
          "effects": [
            {
              "name": "StartSession",
              "payload": {
                "attempt": 1,
                "phase": "implementation",
                "round": {
                  "$ref": "data:round"
                }
              }
            }
          ],
          "goTo": "IMPLEMENTATION",
          "set": {
            "attempt": 1
          }
        },
