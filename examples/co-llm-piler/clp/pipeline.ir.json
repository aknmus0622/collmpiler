{
  "behaviors": [
    {
      "from": [
        "GRADING"
      ],
      "name": "CurrentCodeGraded",
      "onlyIf": [],
      "when": {
        "The check passed": {
          "does": "Nothing: there is nothing to implement.",
          "effects": [],
          "goTo": "DONE"
        },
        "otherwise": {
          "does": "An implementation session is started (attempt 1).",
          "effects": [
            {
              "name": "StartSession",
              "payload": {
                "attempt": 1,
                "phase": "implementation",
                "round": {
                  "$ref": "data:round"
                }
              }
            }
          ],
          "goTo": "IMPLEMENTATION"
        }
      }
    },
    {
      "from": [
        "DESIGN"
      ],
      "name": "DesignChecked",
      "onlyIf": [],
      "when": {
        "The check passed": {
          "does": "The attempt number goes back to 1. A wiring session is started.",
          "effects": [
            {
              "name": "StartSession",
              "payload": {
                "attempt": 1,
                "phase": "wiring",
                "round": {
                  "$ref": "data:round"
                }
              }
            }
          ],
          "goTo": "WIRING",
          "set": {
            "attempt": 1
          }
        },
        "The check was rejected and attempts remain in this phase": {
          "does": "The attempt number goes up by one. A design session is started with the new attempt number.",
          "effects": [
            {
              "name": "StartSession",
              "payload": {
                "attempt": {
                  "$ref": "calculation:nextAttempt"
                },
                "phase": "design",
                "round": {
                  "$ref": "data:round"
                }
              }
            }
          ],
          "goTo": "DESIGN",
          "set": {
            "attempt": {
              "$ref": "calculation:nextAttempt"
            }
          }
        },
        "The check was rejected, no attempts remain in this phase, and rounds remain": {
          "does": "The round number goes up by one and the attempt number goes back to 1. The code is discarded if it was being written from nothing. Then a design session is started in the new round.",
          "effects": [
            {
              "name": "DiscardCode",
              "payload": {},
              "when": "The code is being written from nothing"
            },
            {
              "name": "StartSession",
              "payload": {
                "attempt": 1,
                "phase": "design",
                "round": {
                  "$ref": "calculation:nextRound"
                }
              }
            }
          ],
          "goTo": "DESIGN",
          "set": {
            "attempt": 1,
            "round": {
              "$ref": "calculation:nextRound"
            }
          }
        },
        "otherwise": {
          "does": "Nothing.",
          "effects": [],
          "goTo": "FAILED"
        }
      }
    },
    {
      "from": [
        "IMPLEMENTATION"
      ],
      "name": "ImplementationChecked",
      "onlyIf": [],
      "when": {
        "The check passed": {
          "does": "Nothing.",
          "effects": [],
          "goTo": "DONE"
        },
        "The check was rejected and attempts remain in this phase": {
