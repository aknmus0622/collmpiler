            "incremental": {
              "$ref": "decision:plan.incremental"
            },
            "maxAttempts": {
              "$ref": "input:attemptsPerPhase"
            },
            "maxRounds": {
              "$ref": "input:rounds"
            },
            "round": 1
          }
        },
        "There is production code, the boundary is unchanged, and there is no adapter": {
          "does": "The pipeline remembers the two limits and whether the plan is incremental, and that this is round 1, attempt 1. A session of the plan's phase is started.",
          "effects": [
            {
              "name": "StartSession",
              "payload": {
                "attempt": 1,
                "phase": {
                  "$ref": "decision:plan.phase"
                },
                "round": 1
