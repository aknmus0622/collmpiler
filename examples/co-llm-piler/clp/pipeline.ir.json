        },
        "otherwise": {
          "does": "Nothing.",
          "effects": [],
          "goTo": "FAILED"
        }
      }
    }
  ],
  "decisions": {
    "plan": {
      "rows": {
        "There is no production code yet": {
          "incremental": false,
          "phase": "design"
        },
        "There is production code, and the boundary differs from the previous run": {
          "incremental": true,
          "phase": "design"
        },
        "There is production code, the boundary is unchanged, and there is no adapter": {
          "incremental": true,
          "phase": "wiring"
        },
        "otherwise": {
          "incremental": true,
          "phase": null
        }
      }
    }
  },
  "irVersion": 3,
  "model": {
    "calculations": {
      "nextAttempt": {
        "is": "the current attempt number plus one",
        "type": "integer"
      },
      "nextRound": {
        "is": "the current round number plus one",
        "type": "integer"
      }
    },
    "commands": {
      "CurrentCodeGraded": {
        "passed": "boolean"
      },
      "DesignChecked": {
        "passed": "boolean"
      },
      "ImplementationChecked": {
        "passed": "boolean"
      },
      "Start": {
        "attemptsPerPhase": {
          "max": 3,
          "min": 1,
          "type": "integer"
        },
        "rounds": {
          "max": 3,
          "min": 1,
          "type": "integer"
        }
      },
      "WiringChecked": {
        "passed": "boolean"
      }
    },
    "data": {
      "attempt": {
        "max": 4,
        "min": 1,
        "type": "integer"
      },
      "incremental": "boolean",
      "maxAttempts": {
        "max": 3,
        "min": 1,
        "type": "integer"
      },
      "maxRounds": {
        "max": 3,
        "min": 1,
        "type": "integer"
      },
      "round": {
        "max": 4,
        "min": 1,
        "type": "integer"
      }
    },
    "effects": {
      "DiscardCode": {},
      "GradeCurrentCode": {
        "round": {
          "max": 4,
          "min": 1,
          "type": "integer"
        }
      },
      "StartSession": {
        "attempt": {
          "max": 4,
          "min": 1,
          "type": "integer"
        },
        "phase": [
          "design",
          "wiring",
          "implementation"
        ],
        "round": {
          "max": 4,
          "min": 1,
          "type": "integer"
        }
      }
    },
    "init": "IDLE",
    "invariants": [
      "The attempt number never exceeds the limit of attempts per phase",
      "The round number never exceeds the limit of rounds"
    ],
    "queries": {
      "boundaryChanged": "boolean",
      "hasAdapter": "boolean",
      "hasProductionCode": "boolean"
    },
    "states": [
      "IDLE",
      "DESIGN",
      "WIRING",
      "GRADING",
      "IMPLEMENTATION",
      "DONE",
      "FAILED"
    ]
  }
}
